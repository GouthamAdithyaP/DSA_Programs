import java.util.HashMap;

public class StringFrequencyCountHashMap {
    public static void main(String args[]){
        String str = "programming";
        StringFrequencyCountHashMap Freq =new StringFrequencyCountHashMap();
        Freq.getStringFreq(str);
    }
  public void getStringFreq(String str){
        HashMap<Character,Integer> map =new HashMap<>();
        for(int i=0;i<str.length();i++){
            map.put(str.charAt(i),map.getOrDefault(str.charAt(i),0)+1);
        }
        System.out.println("The frequency of each letter is "+map);
  }

}
