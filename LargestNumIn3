public class LargestNumIn3 {
    public static void main(String args[]){
            int a=6;
            int b=1;
            int c=5;
            if(a>=b && a>=c){
                System.out.print("A is greater");
            }
            else if(b>=a && b>=c){
                System.out.print("B is greater");
            }
            else{
                System.out.print("C is greater");
            }
    }
}
